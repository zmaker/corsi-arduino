            ]
        ]
    },
    {
        "id": "1254f865a91490ee",
        "type": "function",
        "z": "2a2b8378210d3e96",
        "name": "function 8",
        "func": "let products = flow.get(\"table\") || [];\n\nconst id = parseInt(msg.req.params.id);\n\nconst index = products.findIndex( p => p.id === id ); \n\nif (index === -1) {\n    msg.payload = { error: \"prodotto non trovato\" };\n    msg.statusCode = 404;\n    return msg;\n}\n\nconst data = msg.payload;\n\nif (data.name !== undefined) {\n    products[index].name = data.name;\n}\nif (data.price !== undefined && typeof data.price === 'number') {\n    products[index].price = data.price;\n}\n\nflow.set(\"table\", products);\n\nmsg.statusCode = 200;\nmsg.payload = products[index];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
