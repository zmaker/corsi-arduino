    {
        "id": "91b02186488c906b",
        "type": "function",
        "z": "2a2b8378210d3e96",
        "name": "function 7",
        "func": "let products = flow.get(\"table\") || [];\n\nlet p1 = msg.payload;\n\nif ( !p1.name || typeof p1.price !== 'number' ) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"dati errati\" };\n    return msg;\n}\n\nconst newid =  (products.length > 0) ? (Math.max(...products.map(p => p.id) ) + 1) : 1;\n\nconst product = {\n    id: newid,\n    name: p1.name,\n    price: p1.price\n};\n\nproducts.push(product);\n\nflow.set(\"table\", products);\n\nmsg.statusCode = 201;\nmsg.payload = product;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 400,
