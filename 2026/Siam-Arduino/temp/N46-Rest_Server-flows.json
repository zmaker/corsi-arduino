        "id": "2f185c463ae50011",
        "type": "function",
        "z": "2a2b8378210d3e96",
        "name": "function 6",
        "func": "const products = flow.get(\"table\") || [];\n\nconst id = parseInt(msg.req.params.id);\n\nconst product = products.find( p => p.id === id ); \n\nif (product) {\n    msg.payload = product;\n    msg.statusCode = 200;\n} else {\n    msg.payload = { error: \"prodotto non trovato\" };\n    msg.statusCode = 404;\n}\n\nreturn msg;",
