        "func": "// dati ricevuti dall'ESP32\nlet tipo = msg.payload.sensorId;   // es. temperatura\nlet valore = msg.payload.value;    // es. 23.5\nlet tm = msg.payload.timestamp\n\nlet str = \"INSERT INTO dati_sensori (tipo_misura, valore, data)\"+\n\" VALUES ('\"+tipo +\"', \"+valore+\", '\"+tm+\"')\";\n\nnode.warn(str);\n\nvar msg1 = {\n\"topic\": str };\n\nreturn msg1;\n",
